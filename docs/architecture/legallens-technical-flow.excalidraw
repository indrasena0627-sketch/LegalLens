      "isDeleted": false,
      "boundElements": [],
      "updated": 1790905921712,
      "link": null,
      "locked": false,
      "text": "small fast model + structured output (Pydantic enum), few-shot, conversation-aware\n   intent = one of { ask · summary · draft · out_of_scope }   +   confidence   +   extracted slots\n   ask → question, scope        summary → doc_id, template override\n   draft → draft_type, params   out_of_scope → refusal reason\nfallbacks:  explicit mode chip overrides the router  ·  confidence < 0.6 → ask the user to disambiguate",
      "originalText": "small fast model + structured output (Pydantic enum), few-shot, conversation-aware\n   intent = one of { ask · summary · draft · out_of_scope }   +   confidence   +   extracted slots\n   ask → question, scope        summary → doc_id, template override\n   draft → draft_type, params   out_of_scope → refusal reason\nfallbacks:  explicit mode chip overrides the router  ·  confidence < 0.6 → ask the user to disambiguate",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
