      "boundElements": [],
      "updated": 1790905921727,
      "link": null,
      "locked": false,
      "text": "The small chip at the bottom-right of a box is the requirement\nit implements, traceable to docs/LegalLens-BRD-PRD-FRD.md —\nFR = functional, NFR = non-functional, DR = data, TS = trust\n& safety, BR = business objective.",
      "originalText": "The small chip at the bottom-right of a box is the requirement\nit implements, traceable to docs/LegalLens-BRD-PRD-FRD.md —\nFR = functional, NFR = non-functional, DR = data, TS = trust\n& safety, BR = business objective.",
      "fontSize": 13.5,
      "fontFamily": 2,
