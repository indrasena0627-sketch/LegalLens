    },
    {
      "id": "lg_nb",
      "type": "text",
      "x": 5342,
      "y": 1468,
      "width": 414.36,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0541",
      "roundness": null,
      "seed": 1055909349,
      "version": 3,
      "versionNonce": 105097950,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790905921727,
      "link": null,
      "locked": false,
      "text": "Lane 5 (1) is a release gate, not a quality check. An output\ncarrying a citation that does not resolve to a span retrieved\non this turn is never shown — it is stripped or the whole\noutput is refused. Everything upstream exists to make that\ngate cheap to pass.",
