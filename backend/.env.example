# Legal Lens backend configuration. Copy to `.env` and edit as needed.
# Every value below is a default — the app runs with none of them set.

# dev | test | production
LL_ENV=dev

# --- transport ---------------------------------------------------------
LL_HOST=127.0.0.1
LL_PORT=8000
# JSON list. Must include the Vite dev server for the cookie to be accepted.
LL_CORS_ORIGINS=["http://localhost:5173"]

# --- persistence -------------------------------------------------------
# Postgres at M6 is a URL change and nothing else:
#   postgresql+asyncpg://user:pass@host/legallens
LL_DATABASE_URL=sqlite+aiosqlite:///./legallens.db
LL_DATA_DIR=./data

# --- secrets -----------------------------------------------------------
# REQUIRED IN PRODUCTION — startup refuses without them.
#
# Outside production, a stable key is generated into data/.dev-secrets.json on
# first run and reused. That matters: an ephemeral key would make every blob
# written by the previous process undecryptable.
#
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
#
# LL_BLOB_KEY   AES-256-GCM over uploads, extracted page text and page images
#               (NFR-9). Losing it means losing every stored document.
# LL_SECRET_KEY signs session cookies and short-lived blob read URLs.
#LL_BLOB_KEY=
#LL_SECRET_KEY=

# --- sessions (FR-27) --------------------------------------------------
LL_SESSION_TTL_DAYS=14
LL_SESSION_COOKIE_NAME=ll_session
# Set true behind TLS. Leave false for http://localhost or the cookie is dropped.
LL_COOKIE_SECURE=false

# --- limits (NFR-4, FR-2) ----------------------------------------------
LL_MAX_UPLOAD_BYTES=52428800
LL_MAX_PAGES=500
LL_MAX_DOCUMENTS=50
LL_ACCEPTED_EXTENSIONS=[".pdf",".docx",".txt"]

# --- rate limits -------------------------------------------------------
LL_RATE_LIMIT_TURNS_PER_MIN=20
LL_RATE_LIMIT_UPLOADS_PER_MIN=30
LL_RATE_LIMIT_READS_PER_MIN=600
LL_LOGIN_ATTEMPTS_PER_MIN=10

# --- ingestion (NFR-5) -------------------------------------------------
LL_INGEST_CONCURRENCY=3
LL_INGEST_MAX_ATTEMPTS=3
LL_INGEST_VISIBILITY_TIMEOUT_S=300
# Below this mean OCR confidence a document is quarantined, not indexed (DR-1).
LL_OCR_CONFIDENCE_FLOOR=0.50
# Chars per page below which a PDF is treated as scanned rather than text-layer.
LL_TEXT_LAYER_CHARS_PER_PAGE_FLOOR=120

# --- generation --------------------------------------------------------
LL_GENERATION_BUDGET_S=60
LL_SSE_KEEPALIVE_S=15
# Multiplies the fixture engine's artificial delays. 1.0 keeps the realistic
# ~600ms TTFT the streaming UI was built against; the tests use 0.02.
LL_STREAM_DELAY_FACTOR=1.0

# --- dev seed ----------------------------------------------------------
LL_SEED_EMAIL=dana@example.com
LL_SEED_PASSWORD=counsel-demo-2026
LL_WORKSPACE_NAME=Dana's workspace
